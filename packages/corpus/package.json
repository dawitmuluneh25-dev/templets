{
  "name": "@reporting/corpus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "bin": {
    "reporting-corpus": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import": "node dist/cli.js"
  },
  "dependencies": {
    "@reporting/template-schema": "workspace:*",
    "@reporting/tokens": "workspace:*"
  }
}
