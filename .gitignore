# Operating system and editor noise
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Dependencies (none today: the prototype has no package.json, but the
# production plan introduces one — keep installs out of the tree)
node_modules/
.pnpm-store/
bower_components/
vendor/

# Python bytecode (tools/ is Node today; the corpus scripts were Python)
__pycache__/
*.py[cod]
.venv/
venv/

# Build / distribution output
dist/
build/
out/
coverage/
*.tsbuildinfo

# Test and export artifacts (regenerated by tools/test-export.mjs)
sample-report*.pdf
*.pdf.out
playwright-report/
test-results/
blob-report/

# Packaged snapshots — git supersedes these; regenerate when needed
*.zip
*.7z
*.tar
*.tar.gz

# Local QA capture output (screenshots are regenerated, not versioned)
qa-output/
qa-*/
docs/qa/**/*.png
docs/qa/**/*.jpg

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.json

# Logs and local databases
*.log
npm-debug.log*
yarn-error.log*
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Scratch
tmp/
scratch/
*.bak
*.orig
*.rej

# Turborepo local cache
.turbo/

