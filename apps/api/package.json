{
  "name": "@reporting/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "node dist/cli.js openapi",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js",
    "import-templates": "node --env-file-if-exists=../../.env.local dist/cli.js import-templates"
  },
  "dependencies": {
    "@reporting/contracts": "workspace:*",
    "@reporting/db": "workspace:*",
    "@reporting/tokens": "workspace:*",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
