# Copy to .env.local and fill in. .env.local is gitignored and must never be
# committed: it holds the local database passwords.
#
# The roles are created by db/setup/bootstrap.sql (run once as a superuser).
# Two roles, because ADR-0003 requires that the application role owns nothing
# and cannot bypass row-level security:
#
#   reporting_owner  — owns the schema, runs migrations
#   reporting_app    — the runtime role; no BYPASSRLS, no table ownership

# Migration and seed connection (owner).
DATABASE_URL=postgres://reporting_owner:CHANGE_ME@127.0.0.1:5432/reporting_dev

# Runtime connection (application role).
APP_DATABASE_URL=postgres://reporting_app:CHANGE_ME@127.0.0.1:5432/reporting_dev

# Test database. The isolation test truncates these tables, so it must never
# point at a database you care about.
TEST_DATABASE_URL=postgres://reporting_owner:CHANGE_ME@127.0.0.1:5432/reporting_test
TEST_APP_DATABASE_URL=postgres://reporting_app:CHANGE_ME@127.0.0.1:5432/reporting_test
